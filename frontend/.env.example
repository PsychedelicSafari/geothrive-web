# Copy this file to .env.local and fill in real values (never commit .env*).

# AfriGIS geospatial data credentials.
AFRIGIS_CLIENT_NAME=trial-geotribe
AFRIGIS_CLIENT_ID=
AFRIGIS_CLIENT_SECRET=
AFRIGIS_API_KEY=

# The GeoThrive grid, read directly. This app used to proxy a FastAPI service on Railway,
# which held the connection instead. It now queries Supabase itself, so this is the only
# credential the grid needs.
#
# Use the POOLER host, not `db.<ref>.supabase.co`. The direct host is IPv6-only and will not
# resolve from most networks. Port 6543 is transaction mode, which is the right one for
# serverless; 5432 is session mode and is for long-lived processes.
#
# Connect as `substrate_ro`, never `postgres`. Supavisor silently drops the `options` startup
# parameter, so a search_path or read-only flag set on this URL never arrives. Both are
# attached to the role instead, which is server-side state the pooler does honour:
#   ALTER ROLE substrate_ro SET search_path = geothrive, public;
#   ALTER ROLE substrate_ro SET default_transaction_read_only = on;
#   ALTER ROLE substrate_ro SET statement_timeout = '15s';
# Every query here schema-qualifies its tables anyway, so the search_path is belt and braces.
DATABASE_URL=postgresql://substrate_ro.<project_ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Which licence tier this deployment reads at: basic, standard, or enterprise. Decides which
# source layers come back, because licensed AfriGIS and government data cannot be
# redistributed. Defaults to basic, which is what the old API key resolved to.
GEOTHRIVE_TIER=basic

# What /api/grid/health reports as the location of the grid. Set this if the database moves,
# so the app does not claim a residency it no longer has.
GEOTHRIVE_DB_LOCATION=Supabase eu-central-1 (Frankfurt)
